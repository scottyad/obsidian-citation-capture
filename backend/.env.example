# Obsidian Citation Capture — Local Server Environment
# Copy this to .env and fill in your values

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Stripe (Required for payment processing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (Create these in Stripe Dashboard → Product Catalog)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PROPLUS=price_...
STRIPE_PRICE_LIFETIME=price_...

# Anthropic (Required for Cloud AI proxy)
ANTHROPIC_API_KEY=sk-ant-...

# Admin API Key for manual license generation
ADMIN_API_KEY=your-random-secret-key-here

# Frontend URL (for CORS and redirect URLs)
FRONTEND_URL=http://localhost:5173

# License Settings
DEFAULT_CLOUD_CREDITS=200
CREDITS_RESET_DAY=1

# Optional: SQLite database path (defaults to ./data/licenses.db)
DATABASE_URL=sqlite:///data/licenses.db
