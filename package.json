{
  "name": "obsidian-citation-capture-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Academic Citation to Obsidian Capture - Chrome Extension and Obsidian Plugin Monorepo",
  "workspaces": [
    "shared",
    "chrome-extension",
    "obsidian-plugin"
  ],
  "scripts": {
    "build": "npm run build:shared && npm run build:chrome && npm run build:obsidian",
    "build:shared": "npm --prefix shared run build",
    "build:chrome": "npm --prefix chrome-extension run build",
    "build:obsidian": "npm --prefix obsidian-plugin run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "happy-dom": "^14.3.8",
    "typescript": "^5.4.2",
    "vitest": "^1.4.0"
  }
}
